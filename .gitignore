# Erzeugte Dateien. Sie liegen NICHT im Zweig "main":
#
#   - auf dem Mac entstehen sie lokal fürs Dashboard und die Mitteilungen
#   - im Netz erzeugt sie die GitHub-Automatik im Zweig "gh-pages"
#
# Lägen sie auch in "main", würden sich beide Seiten gegenseitig
# überschreiben, sobald man einmal "git pull" macht.
daten/
.DS_Store

# Rechtefreigaben gelten nur auf diesem Mac.
.claude/settings.local.json

# Die Meldung fuer die Push-Benachrichtigung. Entsteht bei jedem Lauf neu
# und wird von der Automatik sofort verschickt.
meldung.json
